# Copy to config.env and fill in. config.env is gitignored — it holds account
# identifiers, not secrets, but there is no reason to publish them either.
#
#   cp config.env.example config.env && $EDITOR config.env
#
# Both the Makefile and scripts/ source this. Anything named TF_VAR_* is picked up
# by Terraform automatically, so these are NOT duplicated into per-stack tfvars.

# ---------------------------------------------------------------------------
# Identity — find these with:  make ids
# ---------------------------------------------------------------------------

# Numeric organization ID (gcloud organizations list).
TF_VAR_org_id=

# Billing account in XXXXXX-XXXXXX-XXXXXX form (gcloud billing accounts list).
TF_VAR_billing_account=

# Cloud Identity customer ID, format C0xxxxxxx. Required for the domain-restricted
# sharing policy (NIST AC-3 / AC-20). Leave blank to skip that one constraint.
TF_VAR_customer_id=

# ---------------------------------------------------------------------------
# Naming
# ---------------------------------------------------------------------------

# Prefix for every project this stack creates. 3-10 lowercase chars.
# Project IDs must be globally unique, so pick something unlikely to collide.
TF_VAR_prefix=gcpstudy

# Display name of the playground folder created under the org.
TF_VAR_folder_name=gcp-study-playground

TF_VAR_default_region=us-central1
TF_VAR_default_zone=us-central1-a

# ---------------------------------------------------------------------------
# State — populated by `make bootstrap`. Leave blank on first run.
# ---------------------------------------------------------------------------

GCP_SEED_PROJECT=
TF_VAR_state_bucket=

# ---------------------------------------------------------------------------
# Blast radius
# ---------------------------------------------------------------------------
#
# Space-separated project IDs, folder IDs, or any other identifier that this stack
# must never touch. scripts/guard.sh fails any plan whose resource changes so much
# as mention one of them, in either their before or after state.
#
# Put the project IDs you must never touch here. There is deliberately no default: a
# default would protect someone else's project and not yours, which is worse than
# no protection because it looks like protection.
#
# This is the backstop behind folder-scoping, not the primary control. Layers 1 and
# 1b of the guard (no writes at the org node) work regardless of this setting.
# See docs/architecture.md.
#
#   PROTECTED_IDS="my-prod-project my-other-prod-project"
PROTECTED_IDS=""

# Cost ceiling in USD for the folder-level budget alert (NIST-adjacent: this is
# operational hygiene, not a control). Alerts only; it does not cap spend.
TF_VAR_budget_amount=20
